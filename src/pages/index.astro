---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";
import * as indexContent from "../content/index.md";
const compiled = await indexContent.compiledContent();
import "./index.css";
---

<BaseLayoutAstroComponent>
	<div class="bg-image-container">
		<h1>Подстичемо заједништво и чување природе кроз активизам и едукацију.</h1>
	</div>
	<main>
		<Fragment set:html={compiled} />
	</main>
</BaseLayoutAstroComponent>

