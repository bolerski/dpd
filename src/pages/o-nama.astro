---
import GreenHeading from "../components/GreenHeading.astro";
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import aboutUsImage from "../assets/o-nama.jpg";
import DescriptionList from "../components/DescriptionList.astro";
import DescriptionItem from "../components/DescriptionItem.astro";
import "../styles/about-us.css";
---

<BaseLayoutAstroComponent>
	<GreenHeading>🌿 Заједно чувамо природу. Заједно градимо одговорну заједницу</GreenHeading>
	<main>
		<div class="image-container">
			<Image src={aboutUsImage} alt="Друштво под дудом - о нама" />
		</div>

		<p class="about-us-description">
			Удружење „Друштво под дудом“ Моровић је невладино и непрофитно удружење основано 2024. године
			са циљем заштите и унапређења животне средине, развоја руралне заједнице и подстицања активног
			учешћа грађана у очувању природе. Кроз волонтерске акције, едукативне програме и догађаје у
			природи, радимо на конкретним променама у нашој заједници. Верујемо да одговорност према
			животној средини почиње у сопственом дворишту, улици, селу.
		</p>
		<section class="foundations" id="foundations">
			<h3>Темељи нашег рада су:</h3>
			<div class="description-list-container">
				<DescriptionList
					items={["ВОЛОНТЕРИЗАМ", "ТРАНСПАРЕНТНОСТ", "СОЛИДАРНОСТ", "АКТИВИЗАМ"]}
					desktopColumnSize={4}
				/>
			</div>
		</section>
		<section class="goals" id="goals">
			<h3>Наши циљеви су:</h3>
			<ul>
				<li>🌱 Унапређење заштите животне средине</li>
				<li>🌱 Едукација деце и младих</li>
				<li>🌱 Организовање волонтерских акција</li>
				<li>🌱 Подстицање здравих животних навика</li>
				<li>🌱 Развој руралног туризма</li>
				<li>🌱 Подршка хуманитарним активностима</li>
			</ul>
			<p class="highlight">
				Посебан акценат стављамо на практичне активности – чишћење природних подручја, пошумљавање,
				еколошке радионице, спортске манифестације у природи и јавне догађаје који подстичу
				одговорно понашање према природним ресурсима.
			</p>
		</section>
		<section class="legal-description">
			<h3>
				Удружење „Друштво под дудом“ Моровић је организовано као невладино и непрофитно удружење
				засновано на принципима демократског одлучивања, транспарентности и активног учешћа чланова.
			</h3>
			<p class="members">Органи Удружења су:</p>
			<div class="government">
				<div>
					<DescriptionItem>СКУПШТИНА</DescriptionItem>
					<div class="desc-container">
						<p>
							<i>Скупштину чине сви чланови Удружења и она представља највиши орган одлучивања</i>
						</p>
						<p>
							<i>
								Скупштина доноси Статут и друге опште акте, усваја план и програм рада, разматра и
								усваја извештаје о раду и финансијском пословању, одлучује о избору и разрешењу
								чланова органа Удружења, као и о статусним питањима и даљем развоју организације.
							</i>
						</p>
					</div>
				</div>
				<div>
					<DescriptionItem>УПРАВНИ ОДБОР</DescriptionItem>
					<div class="desc-container">
						<p>
							<i>
								Управни одбор је извршни орган који руководи радом Удружења између две седнице
								Скупштине.
							</i>
						</p>
						<p>
							<i>
								Он организује активности, спроводи одлуке Скупштине, доноси оперативне и финансијске
								одлуке и стара се о остваривању циљева Удружења.
							</i>
						</p>
						<p>
							<i>
								Председник Управног одбора заступа Удружење у правном промету и одговоран је за
								законитост рада, док заменик председника поступа у његовом одсуству.
							</i>
						</p>
					</div>
				</div>
				<div>
					<DescriptionItem>НАДЗОРНИ ОДБОР</DescriptionItem>
					<div class="desc-container">
						<p>
							<i>
								Надзорни одбор врши контролу финансијског пословања и надзире законитост рада
								Удружења.
							</i>
						</p>
						<p>
							<i>
								О уоченим неправилностима обавештава Управни одбор и Скупштину, чиме обезбеђује
								додатни ниво одговорности и транспарентности.
							</i>
						</p>
					</div>
				</div>
			</div>
		</section>
		<p class="disclaimer">
			Рад Удружења је јаван. Чланство и заинтересована јавност се редовно обавештавају о
			активностима, одлукама и финансијским извештајима. Тиме се обезбеђује поверење, одговорност и
			дугорочна одрживост организације.
		</p>
	</main>
</BaseLayoutAstroComponent>
