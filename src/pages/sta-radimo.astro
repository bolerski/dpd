---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Blog from "../components/Blog.astro";
import GreenHeading from "../components/GreenHeading.astro";

const posts = await getCollection("blog", (entry) => {
	return entry.data.locale === "sr-Cyrl";
});
---

<BaseLayout>
	<main>
		<GreenHeading>🌿 Видљиви смо кроз оно што радимо, не кроз речи. </GreenHeading>
		<Blog posts={posts} />
	</main>
</BaseLayout>
