---
import BaseLayoutAstroComponent from "../../layouts/BaseLayout.astro";
import * as indexContent from "../../content/sr-Latn/index.md";
const compiled = await indexContent.compiledContent();
import "../index.css";
import HomePageTopContent from "../../components/HomePageTopContent.astro";
import HomeFooter from "../../components/HomeFooter.astro";
---

<BaseLayoutAstroComponent>
	<HomePageTopContent
		title="Podstičemo zajedništvo i čuvanje prirode kroz aktivizam i edukaciju."
	/>
	<main>
		<Fragment set:html={compiled} />
	</main>
	<HomeFooter title="Pratite naše aktivnosti na društvenim mrežama" />
</BaseLayoutAstroComponent>
