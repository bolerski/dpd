---
import BaseLayoutAstroComponent from "../../layouts/BaseLayout.astro";
import * as indexContent from "../../content/en/index.md";
const compiled = await indexContent.compiledContent();
import "../index.css";
import HomePageTopContent from "../../components/HomePageTopContent.astro";
import HomeFooter from "../../components/HomeFooter.astro";
---

<BaseLayoutAstroComponent>
	<HomePageTopContent
		title="We foster community and the preservation of nature through activism and education"
	/>
	<main>
		<Fragment set:html={compiled} />
	</main>
	<HomeFooter title="Follow our activities on social media" />
</BaseLayoutAstroComponent>
