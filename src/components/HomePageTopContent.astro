<style>
	.bg-image-container {
		/* Vite automatically bundles, hashes, and optimizes this in build/preview */
		/* background-image: url("../assets/dpd-bg-image.png"); */
		background-image: url("../assets/dpd-bg-image.png");
		background-position: bottom;
		background-repeat: no-repeat;
		background-size: cover;
		min-height: 450px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bg-image-heading {
		color: #ffffff;
		font-size: 1.875rem;
		font-weight: 600;
		text-align: center;
	}
</style>

<div class="bg-image-container">
	<h1 class="bg-image-heading">
		{Astro.props.title}
	</h1>
</div>
