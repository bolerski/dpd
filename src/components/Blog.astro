---
import type { CollectionEntry } from "astro:content";
import { format } from "date-fns";
interface Props {
	posts: Array<CollectionEntry<"blog">>;
}

const { posts } = Astro.props;
const sortedPostsByDescendingDate = posts.sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<style>
	.post {
		margin: 2.5rem 0;
		padding: 1rem;
		text-align: center;
	}

	.post:nth-child(even) {
		background-color: var(--primary);
		color: #ffffff;
	}

	.post-title {
		font-size: 1.5rem;
		padding-bottom: 1rem;
	}
</style>
<div>
	{
		sortedPostsByDescendingDate.map((post) => (
			<article class="post">
				<h2 class="post-title">
					{post.data.title} {format(post.data.date, "d.M.yyyy")}
				</h2>
				<p>{post.body}</p>
			</article>
		))
	}
</div>
